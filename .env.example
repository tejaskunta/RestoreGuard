SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=5433
SOURCE_DB_NAME=appdb
SOURCE_DB_USER=rgadmin
SOURCE_DB_PASSWORD=devpass
FRESH_MAX_AGE_MINUTES=60
DISCORD_WEBHOOK_URL=

# Optional. Leave EMPTY to use whatever pg_dump is on PATH.
# Only set this when the client major MUST differ from PATH's default, e.g.
# PG_CLIENT_BIN=/usr/local/opt/postgresql@16/bin
PG_CLIENT_BIN=