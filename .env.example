# Copy this to .env and fill in real values. Never commit .env to git.
# Local Docker defaults (match docker-compose.yml):
PGHOST=localhost
PGPORT=5432
PGUSER=restoreguard
PGPASSWORD=restoreguard
SOURCEDB=sourcedb
SCRATCHDB=scratch_verify

# Discord failure alerts (see EXPLAIN.md Step 3 for how to create this):
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Flask status app:
FLASK_PORT=5000
LOG_PATH=logs/verification_log.txt
